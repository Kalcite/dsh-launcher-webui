{
  "name": "dsh-launcher",
  "version": "0.6.2",
  "description": "DeepSeek Harness 多功能启动器（Web 仪表盘 + 零依赖 Node 后端）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,srv -c cyan,green \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
